# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://edurevolution-ai-wyxvlktr5q-uw.a.run.app"

# Firebase Auth custom domain helper proxy. Keep this on the Firebase Hosting
# site that serves /__/auth/* helper pages.
FIREBASE_AUTH_HELPER_ORIGIN="https://educationapp26.web.app"

# Microsoft OAuth for real OneDrive / Word workbook integration.
# Paste these from your Azure App Registration.
# The redirect URI must match the live callback configured in Azure.
MICROSOFT_CLIENT_ID="YOUR_AZURE_APP_CLIENT_ID"
MICROSOFT_TENANT_ID="YOUR_AZURE_TENANT_ID"
MICROSOFT_CLIENT_SECRET="YOUR_AZURE_CLIENT_SECRET"
MICROSOFT_REDIRECT_URI="https://edurevolution-ai-wyxvlktr5q-uw.a.run.app/auth"
MICROSOFT_SCOPES="openid profile email offline_access User.Read Files.ReadWrite Files.ReadWrite.All"

# Optional: separate encryption secret for stored Microsoft tokens.
# If omitted, the server falls back to MICROSOFT_CLIENT_SECRET.
MICROSOFT_TOKEN_ENCRYPTION_SECRET="OPTIONAL_SEPARATE_SERVER_ONLY_SECRET"
