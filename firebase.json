{
  "firestore": {
    "rules": "firestore.rules",
    "database": "educationapp"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "educationapp26",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "edurevolution-ai",
          "region": "us-west1"
        }
      }
    ]
  }
}
